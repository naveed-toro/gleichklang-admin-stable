<configuration debug="true">
    <logger name="de.binaerebauten" level="debug"/>
    <logger name="org.hibernate" level="error"/>
    <logger name="org.springframework" level="error"/>
    <logger name="ch.qos.logback" level="error"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <!-- encoders are assigned the type ch.qos.logback.classic.encoder.PatternLayoutEncoder
            by default -->
        <encoder>
            <pattern>%d %-5level [%thread] %logger{10}: %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="MYSQLSLOWQUERY"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>target/logs/mysql-slow-query.log</file>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <fileNamePattern>
                target/logs/mysql-slow-query.%i.log.gz
            </fileNamePattern>
            <minIndex>1</minIndex>
            <maxIndex>3</maxIndex>
        </rollingPolicy>

        <triggeringPolicy
                class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <maxFileSize>10MB</maxFileSize>
        </triggeringPolicy>

        <encoder>
            <pattern>%d %-5level [%thread] %logger{10} %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="MySQL"
            level="DEBUG">
        <appender-ref ref="MYSQLSLOWQUERY"/>
    </logger>

    <!-- http://docs.jboss.org/hibernate/orm/4.3/topical/html/logging/Logging.html -->
    <!-- <logger name="org.hibernate.SQL" level="info"/> -->

    <root level="error">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>